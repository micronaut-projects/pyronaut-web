---
import { SKEPTIC } from "@/lib/site-content";

interface Props {
  tone?: "adaptive" | "dark";
}

const { tone = "adaptive" } = Astro.props;

const box =
  tone === "dark"
    ? "mx-auto mt-12 max-w-4xl rounded-2xl border border-white/15 bg-white/[0.04] p-8"
    : "mx-auto mt-12 max-w-4xl rounded-2xl border border-ink-200 bg-white p-8 dark:border-white/10 dark:bg-white/[0.03]";
const kicker =
  tone === "dark"
    ? "text-xs font-bold uppercase tracking-wider text-flame-400"
    : "text-xs font-bold uppercase tracking-wider text-flame-700 dark:text-flame-400";
const question =
  tone === "dark"
    ? "mt-3 text-xl font-bold leading-8 text-white"
    : "mt-3 text-xl font-bold leading-8 text-ink-900 dark:text-white";
const intro =
  tone === "dark"
    ? "mt-3 text-sm leading-6 text-ink-300"
    : "mt-3 text-sm leading-6 text-ink-500 dark:text-ink-300";
---

<div class={box}>
  <p class={question}>&ldquo;{SKEPTIC.question}&rdquo;</p>
  <p class={intro}>{SKEPTIC.intro}</p>
  {
    SKEPTIC.answers.length > 0 && (
      <ul class="mt-5 grid gap-3 sm:grid-cols-2">
        {SKEPTIC.answers.map((item) => (
          <li>{item}</li>
        ))}
      </ul>
    )
  }
</div>
