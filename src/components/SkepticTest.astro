---
import { SKEPTIC } from "@/lib/site-content";
---

<div class="mt-14 max-w-3xl">
  <h3 class="text-lg font-semibold text-ink-950 dark:text-white">
    {SKEPTIC.question}
  </h3>
  <p class="mt-3 text-base leading-7 text-ink-500 dark:text-ink-300">
    {SKEPTIC.intro}
  </p>
  {
    SKEPTIC.answers.length > 0 && (
      <ul class="mt-5 grid gap-3 sm:grid-cols-2">
        {SKEPTIC.answers.map((item) => (
          <li>{item}</li>
        ))}
      </ul>
    )
  }
</div>
