---
import { Code } from "astro:components";
import Glyph from "@/components/Glyph.astro";
import { CODE_EXAMPLES } from "@/lib/site-content";

/**
 * Tabbed code showcase. Renders dual Shiki themes (light + dark);
 * global.css switches token colors when `.dark` is active.
 * Tabs are labelled by filename, like an editor. A leading Python import
 * block is folded away by default and expands on click, like an IDE fold.
 */
interface Props {
  id?: string;
}

const { id = "code-tabs" } = Astro.props;

const IMPORT_LINE = /^(from\s+\S+\s+import\b|import\s)/;

/**
 * Split a Python sample into its leading import block and the rest.
 * Blank lines between imports stay in the block; parenthesised
 * multi-line imports are followed to their closing paren.
 */
function splitImports(code: string, language: string) {
  if (language !== "python") return { imports: "", count: 0, body: code };
  const lines = code.split("\n");
  let end = 0;
  let count = 0;
  let open = 0;
  for (let i = 0; i < lines.length; i++) {
    const line = lines[i];
    if (open > 0) {
      open += (line.match(/\(/g) ?? []).length - (line.match(/\)/g) ?? []).length;
      end = i + 1;
    } else if (IMPORT_LINE.test(line)) {
      count++;
      open = (line.match(/\(/g) ?? []).length - (line.match(/\)/g) ?? []).length;
      end = i + 1;
    } else if (line.trim() !== "") {
      break;
    }
  }
  return {
    imports: lines.slice(0, end).join("\n"),
    count,
    body: lines.slice(end).join("\n").replace(/^\s*\n/, ""),
  };
}

const examples = CODE_EXAMPLES.map((example) => ({
  ...example,
  ...splitImports(example.code, example.language),
}));

// Always an editor-dark panel, in both site themes.
const s = {
  frame:
    "overflow-hidden rounded-lg border border-ink-800 bg-ink-900 shadow-xl shadow-ink-950/15 dark:border-white/10",
  tabs: "flex overflow-x-auto border-b border-white/10 bg-ink-950",
  tab: "-mb-px shrink-0 border-b-2 border-transparent px-4 py-2.5 font-mono text-xs text-ink-400 transition hover:text-white",
  tabActive: "!border-flame-500 bg-ink-900 !text-white",
  caption: "border-t border-white/10 px-4 py-3 text-xs leading-5 text-ink-400",
  // Fold row: sits where the imports were, in the code's own font metrics.
  fold: "group/fold flex w-fit cursor-pointer list-none items-center gap-2 px-5 pt-4 font-mono text-[0.8125rem] leading-[1.65] text-[#7f848e] outline-none transition hover:text-ink-200 focus-visible:text-ink-200 [&::-webkit-details-marker]:hidden",
  foldBox:
    "rounded border border-white/15 bg-white/5 px-1.5 leading-[1.35] text-ink-300 transition group-hover/fold:border-flame-400/60 group-hover/fold:text-white group-focus-visible/fold:border-flame-400/60",
};
---

<div class:list={["code-block", s.frame]} data-code-tabs={id}>
  <div class={s.tabs} role="tablist" aria-label="Code examples">
    {
      examples.map((example, index) => (
        <button
          type="button"
          role="tab"
          id={`${id}-tab-${example.id}`}
          aria-controls={`${id}-panel-${example.id}`}
          aria-selected={index === 0 ? "true" : "false"}
          class:list={[s.tab, index === 0 && s.tabActive]}
          data-tab={example.id}
          data-active-class={s.tabActive}
        >
          {example.filename}
        </button>
      ))
    }
  </div>
  {
    examples.map((example, index) => (
      <div
        role="tabpanel"
        id={`${id}-panel-${example.id}`}
        aria-labelledby={`${id}-tab-${example.id}`}
        class:list={[index > 0 && "hidden"]}
        data-tab-panel={example.id}
      >
        {example.count > 0 && (
          <details class="code-imports group/imports">
            <summary class={s.fold}>
              <Glyph
                name="chevron-right"
                class="size-3.5 shrink-0 transition-transform group-open/imports:rotate-90 motion-reduce:transition-none"
              />
              <span class={s.foldBox}>imports</span>
            </summary>
            <Code
              code={example.imports}
              lang={example.language}
              themes={{ light: "one-dark-pro", dark: "one-dark-pro" }}
              defaultColor="light"
            />
          </details>
        )}
        <Code
          code={example.body}
          lang={example.language}
          themes={{ light: "one-dark-pro", dark: "one-dark-pro" }}
          defaultColor="light"
        />
        <p class={s.caption}>{example.caption}</p>
      </div>
    ))
  }
</div>

<script>
  for (const root of document.querySelectorAll<HTMLElement>("[data-code-tabs]")) {
    const tabs = root.querySelectorAll<HTMLButtonElement>("[data-tab]");
    tabs.forEach((tab) => {
      tab.addEventListener("click", () => {
        const target = tab.dataset.tab;
        const activeClasses = (tab.dataset.activeClass ?? "").split(/\s+/).filter(Boolean);
        tabs.forEach((other) => {
          const active = other === tab;
          other.setAttribute("aria-selected", active ? "true" : "false");
          activeClasses.forEach((cls) => other.classList.toggle(cls, active));
        });
        root
          .querySelectorAll<HTMLElement>("[data-tab-panel]")
          .forEach((panel) => panel.classList.toggle("hidden", panel.dataset.tabPanel !== target));
      });
    });
  }
</script>
