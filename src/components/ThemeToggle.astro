---
import Glyph from "@/components/Glyph.astro";

/**
 * Light/dark toggle. The BaseLayout inline script applies the stored theme
 * before paint; this button flips the `.dark` class and persists the choice.
 * Pass `label` to render the target theme as text next to the icon (menus).
 */
interface Props {
  class?: string;
  label?: boolean;
}

const {
  class: className = "rounded-lg p-2 text-current transition hover:bg-black/5 dark:hover:bg-white/10",
  label = false,
} = Astro.props;
---

<button
  type="button"
  data-theme-toggle
  class={className}
  aria-label="Toggle dark mode"
  title="Toggle dark mode"
>
  <Glyph name="moon" class="size-5 dark:hidden" />
  <Glyph name="sun" class="hidden size-5 dark:block" />
  {
    label && (
      <>
        <span class="dark:hidden">Use dark theme</span>
        <span class="hidden dark:inline">Use light theme</span>
      </>
    )
  }
</button>

<script>
  for (const button of document.querySelectorAll("[data-theme-toggle]")) {
    button.addEventListener("click", () => {
      const dark = document.documentElement.classList.toggle("dark");
      document.documentElement.style.colorScheme = dark ? "dark" : "light";
      try {
        localStorage.setItem("pyronaut-theme", dark ? "dark" : "light");
      } catch {
        /* private mode: theme just won't persist */
      }
    });
  }
</script>
