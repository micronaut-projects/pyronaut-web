---
import { FOOTER_COLUMNS } from "@/lib/site-content";

const container = "mx-auto max-w-6xl px-5";
---

<footer class="border-t border-ink-200 dark:border-white/10">
  <div class:list={[container, "py-14"]}>
    <div class="grid gap-10 md:grid-cols-[minmax(0,1.2fr)_repeat(3,minmax(0,1fr))]">
      <div>
        <img src="/pyronaut-assets/logo-header.svg" alt="Pyronaut" class="h-8 w-auto dark:hidden" />
        <img src="/pyronaut-assets/logo-header-dark.svg" alt="Pyronaut" class="hidden h-8 w-auto dark:block" />
        <p class="mt-4 max-w-xs text-sm leading-6 text-ink-500 dark:text-ink-400">
          A high-performance Python framework for production services.
        </p>
        <p class="mt-2 max-w-xs text-xs leading-5 text-ink-400 dark:text-ink-500">
          Pyronaut is part of Micronaut, a Commonhaus Foundation project.
        </p>
      </div>
      {
        FOOTER_COLUMNS.map((column) => (
          <div>
            <h3 class="text-sm font-semibold text-ink-950 dark:text-white">{column.title}</h3>
            <ul class="mt-4 grid gap-2.5">
              {column.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="text-sm text-ink-500 transition hover:text-ink-950 dark:text-ink-400 dark:hover:text-white"
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</footer>
