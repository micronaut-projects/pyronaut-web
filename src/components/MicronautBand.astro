---
import { MICRONAUT_AUDIENCE } from "@/lib/site-content";
---

<section class="border-t border-ink-200 bg-ink-50 dark:border-white/10 dark:bg-ink-900/60">
  <div class="mx-auto max-w-6xl px-5 py-6">
    <p class="text-sm leading-6 text-ink-500 dark:text-ink-300">
      <span class="font-semibold text-ink-900 dark:text-white">{MICRONAUT_AUDIENCE.kicker}</span>{" "}
      {MICRONAUT_AUDIENCE.copy}{" "}
      <a
        href={MICRONAUT_AUDIENCE.href}
        class="font-medium text-flame-700 underline decoration-flame-700/30 underline-offset-4 hover:decoration-flame-700 dark:text-flame-400 dark:decoration-flame-400/30 dark:hover:decoration-flame-400"
      >
        {MICRONAUT_AUDIENCE.linkLabel}
      </a>
    </p>
  </div>
</section>
