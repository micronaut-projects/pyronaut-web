---
import { Code } from "astro:components";
import BaseLayout from "@/layouts/BaseLayout.astro";
import CodeTabs from "@/components/CodeTabs.astro";
import Glyph from "@/components/Glyph.astro";
import Mascot from "@/components/Mascot.astro";
import MicronautBand from "@/components/MicronautBand.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import {
  CODE_PROOFS,
  FEATURES,
  PERSONAS,
  SITE_NAME,
  STACK_COMPARISON,
  WORKFLOW,
} from "@/lib/site-content";

/**
 * Homepage. The mascot's flame is the one light source: dark bands (hero,
 * CTA) are lit from where the flamethrower points, and flame orange is kept
 * for things you act on — buttons, commands, the active tab. Everything else
 * is ink and hairlines.
 */

const helloCode = `@Get("/hello/{name}")
def hello(name: str):
    return {"message": f"Hello, {name}"}`;

const createCommand = "pyronaut create rocket-service";

// A sparse, seeded starfield for the dark bands — deterministic so the
// build is stable, uneven so it doesn't read as a pattern.
let seed = 7;
const rand = () => ((seed = (seed * 16807) % 2147483647) - 1) / 2147483646;
const stars = Array.from({ length: 70 }, () => ({
  x: (rand() * 100).toFixed(2),
  y: (rand() * 100).toFixed(2),
  r: (rand() < 0.85 ? 0.6 + rand() * 0.5 : 1.2 + rand() * 0.6).toFixed(2),
  o: (0.15 + rand() * 0.5).toFixed(2),
}));

const container = "mx-auto max-w-6xl px-5";
const sectionRule = "border-t border-ink-200 dark:border-white/10";
const h2 =
  "font-display text-balance text-4xl font-bold leading-[1.05] tracking-[-0.02em] text-ink-950 dark:text-white md:text-5xl";
const lead = "text-base leading-7 text-ink-500 dark:text-ink-300 md:text-lg md:leading-8";
const btnFlame =
  "inline-flex items-center gap-2 rounded-md bg-flame-500 px-5 py-3 text-sm font-semibold text-ink-950 transition hover:bg-flame-400";
const btnGhost =
  "inline-flex items-center rounded-md border border-white/20 px-5 py-3 text-sm font-semibold text-white transition hover:border-white/50";
---

<BaseLayout
  title={`${SITE_NAME} — High-performance Python web framework`}
  bodyClass="bg-white font-sans text-ink-900 antialiased dark:bg-ink-950 dark:text-ink-100"
>
  <SiteHeader />

  <main>
    <!-- Hero -->
    <section class="relative isolate overflow-hidden bg-ink-950 text-white">
      <svg class="absolute inset-0 -z-10 size-full" aria-hidden="true">
        {stars.map((s) => <circle cx={`${s.x}%`} cy={`${s.y}%`} r={s.r} fill="#fff" opacity={s.o} />)}
      </svg>
      <!-- Warm light thrown by the flamethrower -->
      <div
        class="absolute inset-0 -z-10 bg-[radial-gradient(38rem_28rem_at_88%_42%,rgba(249,115,22,0.28),transparent_70%),radial-gradient(60rem_20rem_at_70%_110%,rgba(239,68,68,0.18),transparent_70%)]"
        aria-hidden="true"
      >
      </div>
      <div
        class:list={[
          container,
          "grid gap-14 pb-20 pt-16 lg:grid-cols-[minmax(0,1.1fr)_minmax(0,0.9fr)] lg:items-center lg:gap-10 lg:pb-28 lg:pt-24",
        ]}
      >
        <div>
          <h1
            class="font-display mt-5 text-balance text-5xl font-bold leading-[0.98] tracking-[-0.03em] md:text-7xl lg:text-[3.9rem] xl:text-[4.25rem]"
          >
            A <span class="text-flame-400 sm:whitespace-nowrap">high-performance</span> Python web framework.
          </h1>
          <p class="mt-7 max-w-xl text-lg leading-8 text-ink-300">
            Build production services with rich data access, observability, cloud integrations, build-time validation, integrated testing, and enterprise support.
          </p>
          <div class="mt-9 flex flex-wrap gap-3" id="get-started">
            <a href="/docs/guide/index.html#gettingStarted" class={btnFlame}>
              Get started
              <Glyph name="arrow-right" class="size-4" />
            </a>
            <a href="#features" class={btnGhost}>Explore the framework</a>
          </div>
          <div
            class="mt-8 flex max-w-md items-center gap-3 rounded-md border border-white/10 bg-white/[0.04] py-2 pl-4 pr-2 font-mono text-sm"
          >
            <span class="select-none text-flame-400">$</span>
            <code class="flex-1 truncate text-ink-100">{createCommand}</code>
            <button
              type="button"
              data-copy={createCommand}
              class="rounded px-2 py-1 font-sans text-xs font-medium text-ink-400 transition hover:bg-white/10 hover:text-white"
            >
              Copy
            </button>
          </div>
        </div>

        <div class="relative">
          <Mascot class="mx-auto w-full max-w-lg lg:max-w-none lg:translate-x-6" />
          <figure
            class="code-block relative -mt-6 ml-auto w-[88%] max-w-md overflow-hidden rounded-lg border border-white/10 bg-ink-900/90 shadow-2xl shadow-black/40 backdrop-blur sm:-mt-10"
          >
            <figcaption class="border-b border-white/10 px-4 py-2 font-mono text-xs text-ink-400">
              hello.py
            </figcaption>
            <Code
              code={helloCode}
              lang="python"
              themes={{ light: "one-dark-pro", dark: "one-dark-pro" }}
              defaultColor="light"
            />
          </figure>
        </div>
      </div>
    </section>

    <!-- Features -->
    <section id="features">
      <div class:list={[container, "py-20 lg:py-28"]}>
        <div class="grid gap-6 lg:grid-cols-2 lg:items-end lg:gap-16">
          <h2 class={h2}>Production Python, working together.</h2>
          <p class={lead}>
            Pyronaut brings dependency injection, validation, data access, observability, testing, and packaging into one application model.
          </p>
        </div>
        <div
          class="mt-14 grid gap-px overflow-hidden rounded-lg border border-ink-200 bg-ink-200 dark:border-white/10 dark:bg-white/10 sm:grid-cols-2 lg:grid-cols-3"
        >
          {
            FEATURES.map((feature) => (
              <a
                href={feature.href}
                class="group bg-white p-7 transition hover:bg-flame-50/50 dark:bg-ink-950 dark:hover:bg-white/[0.03]"
              >
                <Glyph name={feature.icon} class="size-6 text-flame-600 dark:text-flame-400" />
                <h3 class="mt-5 flex items-center gap-2 text-lg font-semibold text-ink-950 dark:text-white">
                  {feature.title}
                  <Glyph
                    name="arrow-right"
                    class="size-4 -translate-x-1 text-flame-600 opacity-0 transition group-hover:translate-x-0 group-hover:opacity-100 dark:text-flame-400"
                  />
                </h3>
                <p class="mt-2 text-sm leading-6 text-ink-500 dark:text-ink-300">{feature.copy}</p>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Code showcase -->
    <section id="code" class:list={[sectionRule, "bg-ink-50 dark:bg-ink-900/40"]}>
      <div
        class:list={[container, "grid gap-12 py-20 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.5fr)] lg:gap-16 lg:py-28"]}
      >
        <div class="lg:sticky lg:top-28 lg:self-start">
          <h2 class={h2}>Write Python. Get the platform around it.</h2>
          <p class:list={[lead, "mt-5"]}>
            Your Python types and annotations define routing, validation, serialization, dependency injection, OpenAPI, and tests.
          </p>
          <p class="mt-4 text-sm leading-6 text-ink-500 dark:text-ink-400">
            Pyronaut processes the application model before startup, enabling earlier validation and carrying the same model through development, testing, and packaging.
          </p>
          <ul class="mt-8 divide-y divide-ink-200 border-y border-ink-200 dark:divide-white/10 dark:border-white/10">
            {
              CODE_PROOFS.map((proof) => (
                <li class="py-3 text-sm font-medium leading-6 text-ink-800 dark:text-ink-100">{proof}</li>
              ))
            }
          </ul>
        </div>
        <CodeTabs id="home-code" />
      </div>
    </section>

    <!-- Workflow: the CLI as a pipeline -->
    <section id="workflow" class={sectionRule}>
      <div class:list={[container, "py-20 lg:py-28"]}>
        <h2 class:list={[h2, "max-w-3xl"]}>From Python source to a production artifact.</h2>
        <p class:list={[lead, "mt-5 max-w-xl"]}>
          One CLI coordinates creation, development, testing, validation, and packaging.
        </p>
        <ol class="relative mt-14 grid gap-10 md:grid-cols-5 md:gap-6">
          <span
            class="absolute left-[7px] top-2 h-[calc(100%-1rem)] w-px bg-gradient-to-b from-flame-500 via-flame-500/40 to-ink-200 dark:to-white/10 md:left-0 md:top-[7px] md:h-px md:w-full md:bg-gradient-to-r"
            aria-hidden="true"
          >
          </span>
          {
            WORKFLOW.map((stage, index) => (
              <li class="relative pl-8 md:pl-0 md:pt-9">
                <span
                  class:list={[
                    "absolute left-0 top-0.5 size-[15px] rounded-full border-[3px] md:top-0",
                    index === WORKFLOW.length - 1
                      ? "border-flame-500 bg-flame-500"
                      : "border-flame-500 bg-white dark:bg-ink-950",
                  ]}
                  aria-hidden="true"
                />
                <h3 class="text-lg font-semibold text-ink-950 dark:text-white">{stage.title}</h3>
                <code class="mt-2 inline-block rounded bg-ink-100 px-2 py-1 font-mono text-xs text-ink-800 dark:bg-white/10 dark:text-ink-100">
                  {stage.command}
                </code>
                <p class="mt-3 text-sm leading-6 text-ink-500 dark:text-ink-300">{stage.copy}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <!-- Stack comparison -->
    <section id="compare" class={sectionRule}>
      <div class:list={[container, "py-20 lg:py-28"]}>
        <h2 class:list={[h2, "max-w-3xl"]}>A representative FastAPI stack vs. Pyronaut</h2>
        <p class:list={[lead, "mt-5 max-w-2xl"]}>
          FastAPI is a strong HTTP framework. Pyronaut takes a different approach, combining high performance with data access, observability, build-time validation, testing, and production packaging.
        </p>
        <div class="mt-14 overflow-x-auto">
          <table class="w-full min-w-[640px] border-collapse text-left text-sm">
            <thead>
              <tr>
                <th scope="col" class="w-[18%] border-b border-ink-300 py-4 pr-6 dark:border-white/20">
                  <span class="sr-only">Area</span>
                </th>
                <th
                  scope="col"
                  class="border-b border-ink-300 py-4 pr-6 font-semibold text-ink-500 dark:border-white/20 dark:text-ink-400"
                >
                  {STACK_COMPARISON.conventionalTitle}
                </th>
                <th
                  scope="col"
                  class="rounded-t-lg border-b border-flame-500/40 bg-ink-950 px-5 py-4 font-semibold text-white dark:bg-ink-900"
                >
                  <span class="inline-flex items-center gap-2">
                    <Glyph name="flame" class="size-4 text-flame-400" />
                    {STACK_COMPARISON.pyronautTitle}
                  </span>
                </th>
              </tr>
            </thead>
            <tbody>
              {
                STACK_COMPARISON.rows.map((row) => (
                  <tr class="align-top">
                    <th
                      scope="row"
                      class="border-b border-ink-200 py-4 pr-6 font-medium text-ink-500 dark:border-white/10 dark:text-ink-400"
                    >
                      {row.area}
                    </th>
                    <td class="border-b border-ink-200 py-4 pr-6 text-ink-600 dark:border-white/10 dark:text-ink-300">
                      {row.conventional}
                    </td>
                    <td class="border-b border-white/10 bg-ink-950 px-5 py-4 text-ink-100 dark:bg-ink-900">{row.pyronaut}</td>
                  </tr>
                ))
              }
            </tbody>
            <tfoot>
              <tr>
                <td class="py-4 pr-6"></td>
                <td class="py-4 pr-6 italic text-ink-500 dark:text-ink-400">
                  {STACK_COMPARISON.conventionalFootnote}
                </td>
                <td class="rounded-b-lg bg-ink-950 px-5 py-4 font-medium italic text-flame-300 dark:bg-ink-900">
                  {STACK_COMPARISON.pyronautFootnote}
                </td>
              </tr>
            </tfoot>
          </table>
        </div>
      </div>
    </section>

    <!-- Personas -->
    <section id="teams" class:list={[sectionRule, "bg-ink-50 dark:bg-ink-900/40"]}>
      <div class:list={[container, "py-20 lg:py-28"]}>
        <h2 class:list={[h2, "max-w-3xl"]}>For teams building production Python services.</h2>
        <p class:list={[lead, "mt-5 max-w-xl"]}>
          Choose Pyronaut when your Python services need high performance and deeper production capabilities.
        </p>
        <dl class="mt-14 grid gap-x-10 gap-y-10 sm:grid-cols-2 lg:grid-cols-4">
          {
            PERSONAS.map((persona) => (
              <div class="border-l-2 border-flame-500 pl-5">
                <dt class="text-lg font-semibold text-ink-950 dark:text-white">{persona.role}</dt>
                <dd class="mt-2 text-sm leading-6 text-ink-500 dark:text-ink-300">{persona.value}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </section>

    <!-- CTA -->
    <section class="relative isolate overflow-hidden bg-ink-950 text-white">
      <svg class="absolute inset-0 -z-10 size-full" aria-hidden="true">
        {stars.slice(0, 35).map((s) => <circle cx={`${s.y}%`} cy={`${s.x}%`} r={s.r} fill="#fff" opacity={s.o} />)}
      </svg>
      <div
        class="absolute inset-0 -z-10 bg-[radial-gradient(50rem_22rem_at_50%_120%,rgba(249,115,22,0.35),transparent_70%)]"
        aria-hidden="true"
      >
      </div>
      <div class:list={[container, "flex flex-col items-center py-24 text-center lg:py-32"]}>
        <h2 class="font-display max-w-3xl text-balance text-5xl font-bold leading-[1] tracking-[-0.03em] md:text-6xl">
          Build your first Pyronaut service.
        </h2>
        <p class="mt-6 max-w-xl text-lg leading-8 text-ink-300">
          Start with HTTP, data access, validation, observability, testing, and production packaging in one Python project.
        </p>
        <div class="mt-10 flex flex-wrap justify-center gap-3">
          <a href="/docs/" class={btnFlame}>
            Read the docs
            <Glyph name="arrow-right" class="size-4" />
          </a>
          <a href="https://github.com/micronaut-projects/pyronaut" class={btnGhost}>View the repository</a>
        </div>
      </div>
    </section>

    <MicronautBand />
  </main>

  <SiteFooter />
</BaseLayout>

<script>
  for (const button of document.querySelectorAll<HTMLButtonElement>("[data-copy]")) {
    button.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(button.dataset.copy ?? "");
        button.textContent = "Copied";
        setTimeout(() => (button.textContent = "Copy"), 1500);
      } catch {
        /* clipboard unavailable: leave the text selectable */
      }
    });
  }
</script>
