---
import { render } from "astro:content";
import PageLayout from "@/layouts/PageLayout.astro";
import { SITE_NAME } from "@/lib/site-content";
import {
  categoryLabel,
  formatPostDate,
  getBlogPosts,
  postCategories,
} from "@/lib/blog";

/** Blog posts are served at their dated slug, e.g. /2026/09/23/<name>/. */
export async function getStaticPaths() {
  const posts = await getBlogPosts();
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { title, description, date, author, tags } = post.entry.data;
const categories = postCategories(post);
const { Content } = await render(post.entry);
---

<PageLayout title={`${title} | ${SITE_NAME} Blog`} description={description}>
  <article class="mx-auto max-w-3xl px-5 py-16 md:py-20">
    <a
      href="/blog/"
      class="font-mono text-xs font-bold uppercase tracking-[0.2em] text-ember-500 transition hover:text-flame-600"
    >
      ← Blog
    </a>
    <h1
      class="mt-6 text-4xl font-extrabold tracking-[-0.02em] text-ink-950 dark:text-white md:text-5xl"
    >
      {title}
    </h1>
    <div
      class="mt-6 flex flex-wrap items-center gap-x-4 gap-y-2 font-mono text-xs font-semibold uppercase tracking-wider text-ink-400"
    >
      <time datetime={date.toISOString()}>{formatPostDate(date)}</time>
      {author && <span>{author}</span>}
      {
        categories.map((category) => (
          <a
            href={`/category/${category}/`}
            class="text-ember-500 transition hover:text-flame-600"
          >
            {categoryLabel(category)}
          </a>
        ))
      }
    </div>

    <div class="blog-prose mt-10">
      <Content />
    </div>

    {
      tags.length > 0 && (
        <ul class="mt-12 flex flex-wrap gap-2 border-t border-ink-200/70 pt-8 dark:border-white/10">
          {tags.map((tag) => (
            <li>
              <a
                href={`/tag/${tag}/`}
                class="inline-flex rounded-full bg-white px-3 py-1 font-mono text-xs font-semibold text-ink-600 ring-1 ring-ink-200 transition hover:text-flame-600 hover:ring-flame-500/60 dark:bg-ink-900 dark:text-ink-300 dark:ring-white/10 dark:hover:text-flame-400"
              >
                #{tag}
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </article>
</PageLayout>
