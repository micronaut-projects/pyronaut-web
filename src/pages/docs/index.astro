---
import "@/styles/docs.css";
import PageLayout from "@/layouts/PageLayout.astro";
import { DOCS_LINKS, SITE_NAME } from "@/lib/site-content";
// Generated by scripts/render-docs.mjs from micronaut-projects/pyronaut.
import docs from "@/generated/docs.json";

interface TocNode {
  id: string;
  title: string;
  number: string;
  level: number;
  headings: { id: string; title: string; depth: number }[];
  children: TocNode[];
}

const toc = docs.toc as TocNode[];
const flatten = (nodes: TocNode[]): TocNode[] => nodes.flatMap((node) => [node, ...flatten(node.children)]);
const sections = flatten(toc).filter((node) => node.headings.length > 0);
const sourceHref = `https://github.com/micronaut-projects/pyronaut/tree/${docs.branch}/src/main/docs`;

const tocLink =
  "block rounded-md py-1 pr-2 text-ink-600 transition hover:text-ink-950 dark:text-ink-300 dark:hover:text-white";
---

<PageLayout
  title={`Documentation — ${SITE_NAME}`}
  description="The Pyronaut user guide: installation, getting started, configuration, packaging, and testing."
>
  <div class="mx-auto max-w-7xl px-5 lg:grid lg:grid-cols-[17rem_minmax(0,1fr)] lg:gap-12 xl:max-w-[88rem] xl:grid-cols-[17rem_minmax(0,1fr)_14rem]">
    <!-- Sidebar TOC: sticky on desktop, a collapsible panel on smaller screens. -->
    <aside class="lg:sticky lg:top-16 lg:h-[calc(100dvh-4rem)] lg:overflow-y-auto lg:py-10">
      <details class="docs-toc group border-b border-ink-100 py-4 lg:border-0 lg:py-0 dark:border-white/10" open data-docs-toc>
        <summary
          class="flex cursor-pointer list-none items-center justify-between text-xs font-semibold uppercase tracking-widest text-ink-500 lg:pointer-events-none dark:text-ink-400"
        >
          Pyronaut guide
          {docs.version && <span class="font-mono normal-case tracking-normal text-ink-400">{docs.version}</span>}
        </summary>
        <nav aria-label="Documentation" class="mt-4 text-sm">
          <ol class="space-y-0.5">
            {
              toc.map((node) => (
                <li>
                  <a href={`#${node.id}`} class:list={[tocLink, "font-medium text-ink-800 dark:text-ink-100"]}>
                    <span class="mr-1.5 tabular-nums text-ink-400">{node.number}</span>
                    {node.title}
                  </a>
                  {node.children.length > 0 && (
                    <ol class="mb-1 ml-3 border-l border-ink-100 pl-3 dark:border-white/10">
                      {node.children.map((child) => (
                        <li>
                          <a href={`#${child.id}`} class={tocLink}>
                            <span class="mr-1.5 tabular-nums text-ink-400">{child.number}</span>
                            {child.title}
                          </a>
                          {child.children.length > 0 && (
                            <ol class="ml-3 border-l border-ink-100 pl-3 dark:border-white/10">
                              {child.children.map((grandchild) => (
                                <li>
                                  <a href={`#${grandchild.id}`} class:list={[tocLink, "text-[0.8125rem]"]}>
                                    <span class="mr-1.5 tabular-nums text-ink-400">{grandchild.number}</span>
                                    {grandchild.title}
                                  </a>
                                </li>
                              ))}
                            </ol>
                          )}
                        </li>
                      ))}
                    </ol>
                  )}
                </li>
              ))
            }
          </ol>
        </nav>
        <div class="mt-6 space-y-2 border-t border-ink-100 pt-4 text-sm dark:border-white/10">
          <a href={DOCS_LINKS.micronaut} class:list={[tocLink, "font-medium"]}>Micronaut Docs ↗</a>
          <a href={DOCS_LINKS.guides} class:list={[tocLink, "font-medium"]}>Pyronaut Guides ↗</a>
          <a href={sourceHref} class:list={[tocLink, "font-medium"]}>Docs source on GitHub ↗</a>
        </div>
      </details>
    </aside>

    <article class="min-w-0 py-10 lg:py-12">
      <header class="mb-12">
        <p class="text-sm font-semibold uppercase tracking-widest text-flame-600 dark:text-flame-400">Documentation</p>
        <h1 class="font-display mt-2 text-4xl font-bold tracking-tight text-ink-950 md:text-5xl dark:text-white">
          Pyronaut
        </h1>
        <!-- More documentation beyond this guide, opened with Python / Pyronaut selected. -->
        <div class="mt-8 grid gap-3 sm:grid-cols-2">
          {
            [
              {
                href: DOCS_LINKS.micronaut,
                title: "Micronaut Docs",
                copy: "Reference for the Micronaut framework and modules Pyronaut builds on.",
              },
              {
                href: DOCS_LINKS.guides,
                title: "Pyronaut Guides",
                copy: "Step-by-step tutorials, shown in Python with the Pyronaut build tool.",
              },
            ].map((card) => (
              <a
                href={card.href}
                class="group rounded-xl border border-ink-200 p-4 transition hover:border-flame-400 hover:bg-flame-500/5 dark:border-white/10 dark:hover:border-flame-400"
              >
                <span class="flex items-center justify-between font-semibold text-ink-950 dark:text-white">
                  {card.title}
                  <span class="text-ink-400 transition group-hover:translate-x-0.5 group-hover:text-flame-500" aria-hidden="true">↗</span>
                </span>
                <span class="mt-1 block text-sm text-ink-600 dark:text-ink-300">{card.copy}</span>
              </a>
            ))
          }
        </div>
      </header>
      <div class="docs-prose" set:html={docs.html} />
    </article>

    <!-- On this page: the current section's own subsections, desktop only. -->
    <aside class="hidden xl:sticky xl:top-16 xl:block xl:h-[calc(100dvh-4rem)] xl:overflow-y-auto xl:py-12" data-docs-rail>
      {
        sections.map((section) => (
          <nav aria-label={`On this page: ${section.title}`} data-rail-section={section.id} hidden>
            <p class="text-xs font-semibold uppercase tracking-widest text-ink-500 dark:text-ink-400">On this page</p>
            <ul class="docs-toc mt-4 space-y-0.5 border-l border-ink-100 text-[0.8125rem] dark:border-white/10">
              {section.headings.map((heading) => (
                <li>
                  <a
                    href={`#${heading.id}`}
                    class:list={[tocLink, "-ml-px border-l border-transparent aria-[current=true]:border-flame-500", heading.depth === 1 ? "pl-3" : "pl-6"]}
                  >
                    {heading.title}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }
    </aside>
  </div>
</PageLayout>

<script>
  // Copy buttons on code snippets.
  document.addEventListener("click", async (event) => {
    const button = (event.target as Element).closest<HTMLButtonElement>("[data-copy]");
    const code = button?.closest(".snippet")?.querySelector("pre code");
    if (!button || !code) return;
    const text = [...code.querySelectorAll(".line")]
      .map((line) => [...line.childNodes].filter((n) => !(n instanceof Element && n.classList.contains("conum"))).map((n) => n.textContent).join(""))
      .join("\n");
    try {
      await navigator.clipboard.writeText(text);
      button.dataset.copied = "";
      setTimeout(() => delete button.dataset.copied, 1500);
    } catch {
      // Clipboard access denied; nothing to do.
    }
  });

  // Heading "#" permalinks: jump to the section and copy its full URL.
  document.addEventListener("click", async (event) => {
    const anchor = (event.target as Element).closest<HTMLAnchorElement>(".docs-prose .anchor");
    if (!anchor || event.metaKey || event.ctrlKey || event.shiftKey) return;
    event.preventDefault();
    history.replaceState(null, "", anchor.hash);
    anchor.parentElement?.scrollIntoView({ behavior: "smooth" });
    try {
      await navigator.clipboard.writeText(anchor.href);
      anchor.dataset.copied = "";
      anchor.title = "Link copied";
      setTimeout(() => {
        delete anchor.dataset.copied;
        anchor.title = "Copy link to this section";
      }, 1500);
    } catch {
      // Clipboard access denied; the address bar still has the link.
    }
  });
  for (const anchor of document.querySelectorAll<HTMLAnchorElement>(".docs-prose .anchor")) {
    anchor.title = "Copy link to this section";
    anchor.removeAttribute("aria-hidden");
    anchor.setAttribute("aria-label", `Copy link to ${anchor.parentElement?.textContent?.trim() ?? "this section"}`);
  }

  const tocPanel = document.querySelector<HTMLDetailsElement>("[data-docs-toc]");
  const desktop = window.matchMedia("(min-width: 64rem)");

  // Collapsed by default on small screens; closes after picking a section.
  if (tocPanel) {
    tocPanel.open = desktop.matches;
    desktop.addEventListener("change", (e) => (tocPanel.open = e.matches));
    tocPanel.addEventListener("click", (event) => {
      if (!desktop.matches && (event.target as Element).closest("nav a")) tocPanel.open = false;
    });
  }

  // Scroll spy: highlight the TOC entry of the section being read.
  const links = new Map(
    [...document.querySelectorAll<HTMLAnchorElement>(".docs-toc nav a")].map((a) => [a.hash.slice(1), a]),
  );
  const headings = [...links.keys()]
    .map((id) => document.getElementById(id))
    .filter((el): el is HTMLElement => el !== null);
  let active: HTMLAnchorElement | undefined;

  // Right rail: each TOC section's own headings, shown while that section is read.
  const railNavs = new Map(
    [...document.querySelectorAll<HTMLElement>("[data-rail-section]")].map((nav) => [nav.dataset.railSection!, nav]),
  );
  const railLinks = new Map(
    [...document.querySelectorAll<HTMLAnchorElement>("[data-rail-section] a")].map((a) => [a.hash.slice(1), a]),
  );
  const railHeadings = [...railLinks.keys()]
    .map((id) => document.getElementById(id))
    .filter((el): el is HTMLElement => el !== null);
  let railNav: HTMLElement | undefined;
  let railActive: HTMLAnchorElement | undefined;
  const updateRail = (sectionId: string | undefined) => {
    const nav = sectionId ? railNavs.get(sectionId) : undefined;
    if (nav !== railNav) {
      if (railNav) railNav.hidden = true;
      if (nav) nav.hidden = false;
      railNav = nav;
    }
    let current: HTMLAnchorElement | undefined;
    for (const heading of railHeadings) {
      if (heading.getBoundingClientRect().top >= 120) break;
      const link = railLinks.get(heading.id);
      if (link && nav?.contains(link)) current = link;
    }
    if (current === railActive) return;
    railActive?.removeAttribute("aria-current");
    current?.setAttribute("aria-current", "true");
    railActive = current;
  };

  const update = () => {
    let current = headings[0];
    for (const heading of headings) {
      if (heading.getBoundingClientRect().top < 120) current = heading;
      else break;
    }
    const link = current && links.get(current.id);
    updateRail(current?.id);
    if (link === active) return;
    active?.removeAttribute("aria-current");
    link?.setAttribute("aria-current", "true");
    active = link;
    if (desktop.matches) link?.scrollIntoView({ block: "nearest" });
  };
  document.addEventListener("scroll", update, { passive: true });
  update();
</script>
