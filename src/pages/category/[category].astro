---
import BlogArchive from "@/components/BlogArchive.astro";
import PageLayout from "@/layouts/PageLayout.astro";
import { SITE_NAME } from "@/lib/site-content";
import { categoryLabel, getBlogPosts, postCategories } from "@/lib/blog";

export async function getStaticPaths() {
  const posts = await getBlogPosts();
  const categories = new Set(posts.flatMap(postCategories));
  return [...categories].sort().map((category) => ({
    params: { category },
    props: {
      category,
      posts: posts.filter((post) => postCategories(post).includes(category)),
    },
  }));
}

const { category, posts } = Astro.props;
const label = categoryLabel(category);
---

<PageLayout
  title={`${label} - ${SITE_NAME} Blog`}
  description={`Browse ${SITE_NAME} blog posts in ${label}.`}
>
  <BlogArchive
    eyebrow="Category"
    title={label}
    intro={`Browse ${SITE_NAME} blog posts in ${label}.`}
    posts={posts}
  />
</PageLayout>
